Object subclass: #Categoria	instanceVariableNames: 'preguntas respuesta respcorrecta'	classVariableNames: ''	package: 'Temas'!!Categoria methodsFor: 'initialization' stamp: 'Maria 11/16/2024 15:59'!initialize 	 preguntas:='' asFileReference.	 ! !!Categoria methodsFor: 'accessing - attributes' stamp: 'Maria 11/16/2024 13:57'!ObtenerRespuesta	 respuesta:= (UIManager default request:'Ingrese la respuesta:')asString.	self Comparacion.	! !!Categoria methodsFor: 'accessing - attributes' stamp: 'Maria 11/16/2024 16:21'!Comparacion"ADVERTENCIA: ESTE METODO ES SENSIBLE A LOS ESPACIOS EN BLANCO!!!!"	respuesta:= respuesta asLowercase.	respcorrecta:= respcorrecta asLowercase.	respuesta:= self sinAcentos: respuesta.	respcorrecta:= self sinAcentos: respcorrecta.	(respuesta = respcorrecta ) ifTrue:[Transcript show:'Correcto';cr]  										ifFalse:[Transcript show:'Incorrecto';cr]. ! !!Categoria methodsFor: 'accessing - attributes' stamp: 'Maria 11/16/2024 14:07'!Leerpreguntas|linea contador|contador:=0. preguntas readStreamDo:[:c|	[ contador<20 ] whileTrue:[	linea:= c nextLine.	Transcript show: linea;cr.	linea:=c nextLine.	respcorrecta:= (linea)asString.	contador:=contador + 1.	self ObtenerRespuesta.].].! !!Categoria methodsFor: 'public' stamp: 'Anonymous 11/17/2024 02:26'!sinAcentos: aString    | replacements result |    replacements := Dictionary newFromPairs: {        $á -> $a. $é -> $e. $í -> $i. $ó -> $o. $ú -> $u.        $Á -> $A. $É -> $E. $Í -> $I. $Ó -> $O. $Ú -> $U.        $ñ -> $n. $Ñ -> $N. $ü -> $u. $Ü -> $U }.    result := aString collect: [ :char |        (replacements at: char ifAbsent: [ char ]) ].! !Categoria subclass: #Animales	instanceVariableNames: ''	classVariableNames: ''	package: 'Temas'!!Animales methodsFor: 'initialization' stamp: 'Maria 11/16/2024 15:21'!initialize 	 preguntas:= 'PreguntasdeAnimales.txt' asFileReference.	 ! !Categoria subclass: #Arte	instanceVariableNames: ''	classVaria