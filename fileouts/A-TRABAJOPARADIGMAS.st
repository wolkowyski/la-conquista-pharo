Object subclass: #Casilla	instanceVariableNames: 'jugador posx posy'	classVariableNames: ''	package: 'A-TRABAJOPARADIGMAS'!!Casilla methodsFor: 'public' stamp: 'uwu 11/24/2024 16:37'!darJugador: arg1	jugador := arg1! !!Casilla methodsFor: 'public' stamp: 'uwu 11/24/2024 16:37'!jugador	^ jugador! !!Casilla methodsFor: 'public' stamp: 'uwu 11/24/2024 16:37'!mostrar	| tmp1 |	tmp1 := Array new: 2.	tmp1		at: 1 put: self posx;		at: 2 put: self posy.	^ tmp1! !!Casilla methodsFor: 'public'!posy: arg1	posy := arg1! !!Casilla methodsFor: 'public'!posy	^ posy! !!Casilla methodsFor: 'public'!posx: arg1	posx := arg1! !!Casilla methodsFor: 'public' stamp: 'uwu 11/24/2024 16:37'!posx	^ posx! !!Casilla methodsFor: 'initialize' stamp: 'uwu 11/24/2024 16:37'!initialize	jugador := nil.	posx := nil.	posy := nil! !Object subclass: #Duelo	instanceVariableNames: 'atacante defensor nro'	classVariableNames: ''	package: 'A-TRABAJOPARADIGMAS'!!Duelo methodsFor: 'public'!inicio: arg1 contra: arg2	atacante := arg1.	defensor := arg2! !!Duelo methodsFor: 'initialize'!initialize	atacante := nil.	defensor := nil.	nro := nil! !Object subclass: #Jugador	instanceVariableNames: 'idjugador estado ganoDueloextra territorio jugadoresCerca tema tiempoRestante'	classVariableNames: ''	package: 'A-TRABAJOPARADIGMAS'!!Jugador methodsFor: 'initialize' stamp: 'Anonymous 11/22/2024 02:13'!initialize	idjugador := nil.	jugadoresCerca := OrderedCollection new.	territorio := OrderedCollection new.	tiempoRestante := 45.	estado := 'JUGANDO'.	ganoDueloextra := 0.	tema := nil! !!Jugador methodsFor: 'public'!ganarTerritorio: arg1	arg1 territorio do: [ :arg2 | 		arg2 darJugador: self.		territorio add: arg2 ].	arg1		eliminarTerritorio;		eliminarJugador! !!Jugador methodsFor: 'public'!asignarTiempo: arg1	tiempoRestante := arg1! !!Jugador methodsFor: 'public'!darid: arg1	idjugador := arg1! !!Jugador methodsFor: 'public'!tema	^ tema! !!Jugador methodsFor: 'public'!verTerritorio	^ territorio collect: [ :arg1 | arg1 mostrar ]! !!Jugador methodsFor: 'public'!cambiarEstado: arg1	estado := arg1! !!Jugador methodsFor: 'public' stamp: 'Anonymous 11/22/2024 02:13'!activarDueloExtraganoDueloextra := 3.! !!Jugador methodsFor: 'public'!asignarTerritorio: arg1	territorio add: arg1! !!Jugador methodsFor: 'public' stamp: 'Anonymous 11/22/2024 02:13'!desactivarDueloExtraganoDueloextra := 0.! !!Jugador methodsFor: 'public' stamp: 'Anonymous 11/22/2024 02:13'!reducirDueloExtraganoDueloextra := ganoDueloextra - 1.! !!Jugador methodsFor: 'public'!darTema: arg1	tema := arg1! !!Jugador methodsFor: 'public' stamp: 'Anonymous 11/22/2024 02:14'!tieneDueloExtra^(ganoDueloextra > 0).! !!Jugador methodsFor: 'public'!eliminarTerritorio	territorio := OrderedCollection new! !!Jugador methodsFor: 'public'!ganoDueloextra: arg1	ganoDueloextra := arg1! !!Jugador methodsFor: 'public'!eliminarJugador	self eliminarTerritorio.	estado := 'ELIMINADO'! !!Jugador methodsFor: 'accessing'!idjugador	^ idjugador! !!Jugador methodsFor: 'accessing'!jugadoresCerca	^ jugadoresCerca! !!Jugador methodsFor: 'accessing'!tiempoRestante	^ tiempoRestante! !!Jugador methodsFor: 'accessing'!estado	^ estado! !!Jugador methodsFor: 'accessing'!jugadoresCerca: arg1	jugadoresCerca := arg1! !!Jugador methodsFor: 'accessing'!territorio	^ territorio! !!Jugador methodsFor: 'accessing'!ganoDueloextra	^ ganoDueloextra! !!Jugador methodsFor: 'accessing' stamp: 'Anonymous 11/22/2024 02:20'!tiempoRestante:tiempotiempoRestante:= tiempo! !Morph subclass: #MyProgressBarMorph	instanceVariableNames: 'progressBar progressValue'	classVariableNames: ''	package: 'A-TRABAJOPARADIGMAS'!!MyProgressBarMorph methodsFor: 'initialization' stamp: 'uwu 11/24/2024 16:45'!initialize    super initialize.    progressValue := 0.         self color: Color gray. "Establece el color del fondo de la barra"    "Crea la barra interna de progreso"    progressBar := Morph new.    progressBar color: (Color orange).    self addMorph: progressBar. "Añade la barra interna"! !!MyProgressBarMorph methodsFor: 'removing' stamp: 'uwu 11/24/2024 16:39'!removeProgressBar    self delete. ! !!MyProgressBarMorph methodsFor: 'as yet unclassified' stamp: 'uwu 11/24/2024 16:39'!updateProgress: aValue    progressValue := aValue.     progressBar bounds: (self bounds origin extent: ((self bounds width * progressValue // 100) @ self bounds height)).     progressBar changed. ! !Object subclass: #Pregunta	instanceVariableNames: 'enunciado opciones correcta'	classVariableNames: ''	package: 'A-TRABAJOPARADIGMAS'!!Pregunta methodsFor: 'public'!enunciado	^ enunciado! !!Pregunta methodsFor: 'public'!correcta: arg1	correcta := arg1! !!Pregunta methodsFor: 'public'!correcta	^ correcta! !!Pregunta methodsFor: 'public'!enunciado: arg1	enunciado := arg1! !!Pregunta methodsFor: 'public'!agregarOpcion: arg1	opciones add: arg1! !!Pregunta methodsFor: 'public' stamp: 'Anonymous 11/22/2024 01:17'!opciones^opciones! !!Pregunta methodsFor: 'initialize' stamp: 'Anonymous 11/21/2024 19:44'!initialize	enunciado := ''.	opciones := OrderedCollection new.	correcta := 0.! !Object subclass: #Tablero	instanceVariableNames: 'grilla listaJugadores cantJugadores contadorDuelos'	classVariableNames: ''	package: 'A-TRABAJOPARADIGMAS'!!Tablero methodsFor: 'initialize' stamp: 'Anonymous 11/22/2024 02:48'!initialize	| tmp1 tmp2 tmp4 tmp5 |	listaJugadores := OrderedCollection new.	1 to: 16 do: [ :tmp3 | listaJugadores add: (Jugador new darid: tmp3) ].	grilla := (1 to: 4) collect: [ :arg1 | 		          (1 to: 4) collect: [ :arg2 | Casilla new ] ].	cantJugadores := 16.	tmp1 := OrderedCollection new.	1 to: 16 do: [ :tmp3 | 		tmp4 := nil.		tmp5 := nil.		tmp4 := Tema new.		tmp4			id: tmp3;			nombre: 'Tema ' , tmp3 printString.		tmp5 := FileLocator imageDirectory / 'temas'		        / ('tema' , tmp3 printString , '.txt').		tmp4 cargarPreguntasDesdeArchivo: tmp5 fullName.		tmp1 add: tmp4 ].	tmp2 := listaJugadores shuffled.	tmp2 withIndexDo: [ :arg3 :arg4 | arg3 darTema: (tmp1 at: arg4) ].	contadorDuelos:=0.	self asignarJugadores: listaJugadores! !!Tablero methodsFor: 'public' stamp: 'Anonymous 11/22/2024 02:54'!realizarDueloEntre: ganador y: perdedor    ganador ganarTerritorio: perdedor.    listaJugadores := listaJugadores reject: [:jugador | jugador estado = 'ELIMINADO'].    Transcript show: 'El jugador ', ganador idjugador printString, ' ganó el duelo y tomó el territorio del jugador ', perdedor idjugador printString; cr.    Transcript show: 'Territorio actual del jugador ', ganador idjugador printString, ': ', ganador verTerritorio printString; cr.    ganador darTema: perdedor tema.    Transcript show: 'El jugador ', ganador idjugador printString, ' ahora posee el tema: ', (ganador tema nombre); cr.! !!Tablero methodsFor: 'public'!casillaEn: arg1 columna: arg2	[ ^ grilla at: arg1 - 1 * 3 + arg2 ]! !!Tablero methodsFor: 'public'!listaJugadores	^ listaJugadores! !!Tablero methodsFor: 'public'!buscarJugador: arg1	^ listaJugadores		  detect: [ :arg2 | arg2 idjugador = arg1 ]		  ifNone: [  ]! !!Tablero methodsFor: 'public'!grilla	^ grilla! !!Tablero methodsFor: 'public'!jugadoresCercanosPara: arg1	| tmp1 tmp3 |	tmp1 := OrderedCollection new.	arg1 territorio do: [ :arg2 | 		| tmp4 tmp5 |		tmp4 := arg2 posx.		tmp5 := arg2 posy.		tmp3 := { 			        { 				        (tmp4 - 1).				        tmp5 }.			        { 				        (tmp4 + 1).				        tmp5 }.			        { 				        tmp4.				        (tmp5 - 1) }.			        { 				        tmp4.				        (tmp5 + 1) } }.		tmp3 do: [ :arg3 | 			| tmp6 |			(self esPosicionValida: arg3) ifTrue: [ 				tmp6 := (grilla at: arg3 first) at: arg3 second.				(tmp6 jugador notNil and: [ tmp6 jugador ~= arg1 ]) ifTrue: [ 					(tmp1 includes: tmp6 jugador) ifFalse: [ tmp1 add: tmp6 jugador ] ] ] ] ].	arg1 jugadoresCerca: tmp1.	^ tmp1! !!Tablero methodsFor: 'public' stamp: 'uwu 11/24/2024 16:55'!iniciarDuelo    | atacante posiblesDefensores defensor temaDefensor turno jugadorActual pregunta respuestaUsuario respuestaCorrecta tiempoConsumido inicioTurno finTurno tmp ganador seguirJugando |    atacante := listaJugadores atRandom.    seguirJugando := true.    [seguirJugando] whileTrue: [        "Obtiene los jugadores cercanos al atacante actual"        self contarDuelo.        (contadorDuelos = 10) ifTrue: [            Transcript show: '¡Este es el duelo número 10!! El ganador obtendrá una ventaja especial.'; cr.        ].        posiblesDefensores := self jugadoresCercanosPara: atacante.        posiblesDefensores isEmpty ifTrue: [             Transcript show: 'No hay jugadores cercanos para desafiar.'; cr.            seguirJugando := false.            ^ self         ].        "Muestra las opciones de jugadores cercanos"        Transcript show: 'El jugador ', atacante idjugador printString, ' puede desafiar a:'; cr.        posiblesDefensores withIndexDo: [:jugador :index |            Transcript show: index printString, ') Jugador ', jugador idjugador printString; cr.        ].        "Permite que el atacante elija a quien desafiar"        tmp := (UIManager default request: 'Ingresa el número del jugador a desafiar') asInteger.        (tmp between: 1 and: posiblesDefensores size) ifFalse: [            Transcript show: 'Selección inválida. Turno terminado.'; cr.            seguirJugando := false.            ^ self        ].        Transcript clear.        defensor := posiblesDefensores at: tmp.        Transcript show: 'Duelo iniciado entre el jugador ', atacante idjugador printString, ' y el jugador ', defensor idjugador printString; cr.        "Obtiene el tema del defensor"        temaDefensor := defensor tema.        "Inicia el duelo por turnos"        Transcript show: 'El tema a defender es: ', temaDefensor nombre; cr.        turno := 1.        jugadorActual := atacante. "El atacante comienza"        [atacante tiempoRestante > 0 and: [defensor tiempoRestante > 0]] whileTrue: [            "Selecciona una pregunta del tema del defensor"            pregunta := temaDefensor preguntas atRandom.            "Muestra la pregunta y las opciones"            Transcript show: 'Turno del jugador ', jugadorActual idjugador printString, ': '; cr.            Transcript show: 'Pregunta: ', pregunta enunciado; cr.            1 to: pregunta opciones size do: [:indice |                | opcion |                opcion := pregunta opciones at: indice.                Transcript show: indice printString, ') ', opcion asString; cr.            ].            "Controla el tiempo de respuesta"            inicioTurno := Time millisecondClockValue.            respuestaUsuario := (UIManager default request: 'Ingresa el número de la respuesta') asInteger.            finTurno := Time millisecondClockValue.            tiempoConsumido := (finTurno - inicioTurno) // 1000. "Tiempo en segundos"            jugadorActual asignarTiempo: (jugadorActual tiempoRestante - tiempoConsumido).            "Verifica si la respuesta es correcta"            respuestaCorrecta := pregunta correcta.            (respuestaUsuario = respuestaCorrecta) ifTrue: [                Transcript show: '¡Correcto!!'; cr.            ] ifFalse: [                (jugadorActual tieneDueloExtra) ifTrue: [                    jugadorActual reducirDueloExtra.                    Transcript show: '¡Incorrecto!! Pero el jugador tiene ventaja y no pierde tiempo. Errores restantes: ', jugadorActual ganoDueloextra printString; cr.                ] ifFalse: [                    jugadorActual asignarTiempo: (jugadorActual tiempoRestante - 5).                    Transcript show: '¡Incorrecto!! La respuesta correcta era: ', respuestaCorrecta printString; cr.                    Transcript show: 'Se restan 5 segundos al jugador ', jugadorActual idjugador printString; cr.                ].            ].            "Muestra el tiempo restante del jugador actual"            Transcript show: 'Tiempo restante del jugador ', jugadorActual idjugador printString, ': ', jugadorActual tiempoRestante printString, ' segundos'; cr.            Transcript cr.            "Cambia el turno al otro jugador"            jugadorActual := (jugadorActual = atacante) ifTrue: [defensor] ifFalse: [atacante].            turno := turno + 1.        ].        Transcript clear.        "Determina el perdedor con el tiempo"        (atacante tiempoRestante <= 0)            ifTrue: [                Transcript show: 'El jugador ', atacante idjugador printString, ' se quedó sin tiempo. El jugador ', defensor idjugador printString, ' gana el duelo.'; cr.                self realizarDueloEntre: defensor y: atacante.                ganador := defensor.            ]            ifFalse: [                Transcript show: 'El jugador ', defensor idjugador printString, ' se quedó sin tiempo. El jugador ', atacante idjugador printString, ' gana el duelo.'; cr.                self realizarDueloEntre: atacante y: defensor.                ganador := atacante.            ].        "Restaura el tiempo de ambos jugadores a 45 segundos"        atacante asignarTiempo: 45.        defensor asignarTiempo: 45.		  ganador darTema: defensor tema.        "Aplica la ventaja del duelo numero 10"        (contadorDuelos = 10) ifTrue: [            ganador activarDueloExtra.            Transcript show: 'El jugador ', ganador idjugador printString, ' ha ganado el duelo número 10 y puede equivocarse 3 veces sin perder tiempo.'; cr.		  self inicializarContador        ].        "Opciones para el ganador"        Transcript show: 'El jugador ', ganador idjugador printString, ' puede:'; cr.        Transcript show: '1) Retar a otro jugador cercano'; cr.        Transcript show: '2) Pasar el turno'; cr.        tmp := (UIManager default request: 'Ingresa tu elección') asInteger.        (tmp = 1) ifTrue: [            "Si el ganador sigue jugando"            atacante := ganador.            seguirJugando := true.        ] ifFalse: [            "Pasa el turno a un jugador aleatorio"            atacante := listaJugadores atRandom.            seguirJugando := true.        ].    ].! !!Tablero methodsFor: 'public' stamp: 'Anonymous 11/22/2024 02:05'!contadorDuelos^contadorDuelos! !!Tablero methodsFor: 'public'!esPosicionValida: arg1	^ (arg1 first > 0 and: [ arg1 first <= grilla size ]) and: [ 		  arg1 second > 0 and: [ arg1 second <= (grilla at: 1) size ] ]! !!Tablero methodsFor: 'public' stamp: 'Anonymous 11/22/2024 02:08'!inicializarContadorcontadorDuelos := 0.! !!Tablero methodsFor: 'public'!asignarJugadores: arg1	| tmp1 tmp2 tmp3 tmp4 tmp5 tmp6 tmp8 |	tmp1 := 1.	tmp2 := grilla size.	tmp6 := tmp2.	1 to: tmp6 do: [ :tmp7 | 		tmp3 := (grilla at: tmp7) size.		tmp8 := tmp3.		1 to: tmp8 do: [ :tmp9 | 			tmp4 := nil.			tmp5 := nil.			tmp4 := (grilla at: tmp7) at: tmp9.			tmp4				posx: tmp7;				posy: tmp9.			tmp5 := arg1 at: tmp1.			tmp4 darJugador: tmp5.			tmp5 asignarTerritorio: tmp4.			tmp1 := tmp1 + 1.			tmp1 > arg1 size ifTrue: [ tmp1 := 1 ] ] ]! !!Tablero methodsFor: 'public' stamp: 'Anonymous 11/22/2024 02:08'!contarDuelocontadorDuelos:= contadorDuelos + 1.Transcript show: 'Duelo número: ', contadorDuelos printString; cr.! !Object subclass: #Tema	instanceVariableNames: 'id nombre preguntas'	classVariableNames: ''	package: 'A-TRABAJOPARADIGMAS'!!Tema methodsFor: 'public' stamp: 'Anonymous 11/22/2024 01:59'!id: unidid:=unid! !!Tema methodsFor: 'public' stamp: 'Anonymous 11/22/2024 01:52'!nombre^nombre! !!Tema methodsFor: 'public' stamp: 'uwu 11/24/2024 16:58'!cargarPreguntasDesdeArchivo: arg1    | archivo contenido lineas nombreTema |    archivo := FileLocator imageDirectory / 'temas' / arg1.    contenido := archivo readStream.    lineas := contenido contents lines.    "Guarda el nombre del tema"    nombreTema := lineas first.    self nombre: nombreTema.    "Procesa las preguntas y las opciones"    lineas allButFirst do: [:linea |        | elementos pregunta |        elementos := linea findTokens: ';'.        pregunta := Pregunta new.        pregunta enunciado: (elementos at: 1).        2 to: 5 do: [:i |            pregunta agregarOpcion: (elementos at: i).        ].        pregunta correcta: ((elementos at: 6) asInteger).        self añadirPreg: pregunta.    ].    contenido close.! !!Tema methodsFor: 'public'!añadirPreg: arg1	preguntas add: arg1! !!Tema methodsFor: 'public' stamp: 'Anonymous 11/22/2024 01:52'!nombre:unnomnombre:=unnom! !!Tema methodsFor: 'public' stamp: 'Anonymous 11/22/2024 01:58'!id^id! !!Tema methodsFor: 'public'!preguntas	^ preguntas! !!Tema methodsFor: 'initialize' stamp: 'Anonymous 11/22/2024 01:58'!initialize	nombre:=''.	id:=nil.	preguntas := OrderedCollection new! !Object subclass: #WelcomeInterface	instanceVariableNames: ''	classVariableNames: ''	package: 'A-TRABAJOPARADIGMAS'!"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!WelcomeInterface class	instanceVariableNames: 'dimension'!!WelcomeInterface class methodsFor: 'instance creation' stamp: 'Anonymous 11/23/2024 20:52'!exitGame    (UIManager default confirm: '¿Seguro que quieres salir?') ifTrue: [        Smalltalk quitPrimitive.    ].! !!WelcomeInterface class methodsFor: 'instance creation' stamp: 'uwu 11/24/2024 17:04'!showInstructions    | window instructionsBackground instructionsText |    window := SystemWindow new.    window extent: 500 @ 400.    window setLabel: 'Instrucciones del Juego'.    "Agrega la imagen de fondo"    instructionsBackground := ImageMorph new.    instructionsBackground image: (Form fromFileNamed: (FileLocator imageDirectory / 'instrucciones.png') asFileReference).    instructionsBackground bounds: (0 @ 0 corner: window extent).    window addMorphBack: instructionsBackground.    "Agrega el texto de instrucciones"    instructionsText := TextMorph new.    instructionsText contents: '1. Haz clic en "Iniciar Juego" para comenzar.' , String cr , '2. Usa el menú de configuración para ajustar el tamaño del tablero.' , String cr , '3. ¡Diviértete jugando!!'.    instructionsText font: (TextStyle default fontOfSize: 14).    instructionsText position: (20 @ 50).    instructionsText color: Color white.    window addMorph: instructionsText.    window openInWorld.! !!WelcomeInterface class methodsFor: 'instance creation' stamp: 'Anonymous 11/23/2024 20:51'!getMatrixDimension    ^ Smalltalk at: #MatrixDimension ifAbsent: [ 3 ].! !!WelcomeInterface class methodsFor: 'instance creation' stamp: 'uwu 11/24/2024 20:54'!startGame    | tablero progressBar progressBounds currentValue loadingText |    UIManager default inform: 'Iniciando el juego...'.    "Calcula la posición centrada para la barra de progreso dentro del mundo"    progressBounds := ((World bounds center - (200 @ 15)) corner: (World bounds center + (200 @ 15))).     "Crea y posiciona la barra de progreso"    progressBar := MyProgressBarMorph new.    progressBar bounds: progressBounds.    progressBar openInWorld. "Abre el Morph personalizado en el mundo"    "Crea y posiciona el texto de carga"    loadingText := TextMorph new.    loadingText contents: 'Cargando: 0%'.    loadingText position: (World bounds center - (60 @ 50)).     loadingText font: (TextStyle default fontOfSize: 20).     loadingText color: Color white.    loadingText openInWorld. "Añade el texto al mundo"    "Inicializa el progreso"    currentValue := 0.    [ 1 to: 100 do: [:i |        (Delay forMilliseconds: 20) wait. "Simula el tiempo de carga"        progressBar updateProgress: i. "Actualiza el progreso dinámicamente"        loadingText contents: 'Cargando: ', i asString, '%'. "Actualiza el texto con el progreso"        loadingText changed. "Fuerza el redibujado del texto"    ].    "Finalización: elimina la barra de progreso y el texto"    progressBar removeProgressBar. "Quita la barra una vez completada"    loadingText delete. "Elimina el texto de carga"    "Inicializa el tablero del juego"    tablero := Tablero new.    tablero iniciarDuelo.    UIManager default inform: '¡Juego iniciado!!!!'. "Mensaje opcional"] fork. "Ejecutar en un hilo separado para no bloquear la UI"! !!WelcomeInterface class methodsFor: 'initialization' stamp: 'Anonymous 11/23/2024 20:51'!setMatrixDimension: aDimension    Smalltalk at: #MatrixDimension put: aDimension.! !!WelcomeInterface class methodsFor: 'as yet unclassified' stamp: 'uwu 11/24/2024 17:03'!open    | window titleMorph welcomeLabel startButton configButton instructionsButton aboutButton exitButton backgroundImage buttonColor borderColor buttonOffset |    "Define el color naranja, el borde oscuro y el desplazamiento hacia la izquierda"    buttonColor := Color orange.    borderColor := Color orange darker.    buttonOffset := -100.     "Crea la ventana principal y aumenta el tamaño de la misma"    window := SystemWindow new.    window extent: 800 @ 600.    window setLabel: '- L A   C O N Q U I S T A -'. "Título de la ventana"    titleMorph := TextMorph new.    titleMorph contents: 'Pharo 9.0'.    titleMorph font: (TextStyle default fontOfSize: 18). " Tamaño de la fuente"    titleMorph position: (20 @ 10). "Posición ajustada"    window addMorph: titleMorph.    "Agrega la imagen de fondo escalada"    backgroundImage := ImageMorph new.    backgroundImage image: (Form fromFileNamed: (FileLocator imageDirectory / 'fondo.png') asFileReference).    backgroundImage bounds: (0 @ 0 corner: window extent).    window addMorphBack: backgroundImage.    "Crea una etiqueta de bienvenida"    welcomeLabel := TextMorph new.    welcomeLabel contents: '¡Hola!! Bienvenido a nuestro juego...' , String cr , 'Made by: Los Imaginadores'.    welcomeLabel font: (TextStyle default fontOfSize: 18). "Tamaño de fuente ajustado"    welcomeLabel position: (40 @ 80).    window addMorph: welcomeLabel.    "Crea un botón de inicio"    startButton := SimpleButtonMorph new.    startButton label: 'Iniciar Juego'.    startButton target: self.    startButton actionSelector: #startGame.    startButton bounds: ((240 + buttonOffset) @ 220 extent: 140 @ 50).     startButton color: buttonColor.     startButton borderWidth: 2; borderColor: borderColor.    window addMorph: startButton.    "Crea un botón de configuración"    configButton := SimpleButtonMorph new.    configButton label: 'Configuración'.    configButton target: self.    configButton actionSelector: #configureMatrix.    configButton bounds: ((240 + buttonOffset) @ 290 extent: 140 @ 50).    configButton color: buttonColor.     configButton borderWidth: 2; borderColor: borderColor.     window addMorph: configButton.    "Crea un botón de instrucciones del juego"    instructionsButton := SimpleButtonMorph new.    instructionsButton label: 'Instrucciones del Juego'.    instructionsButton target: self.    instructionsButton actionSelector: #showInstructions.    instructionsButton bounds: ((240 + buttonOffset) @ 360 extent: 140 @ 50).     instructionsButton color: buttonColor.     instructionsButton borderWidth: 2; borderColor: borderColor.     window addMorph: instructionsButton.    "Crea un botón sobre el grupo"    aboutButton := SimpleButtonMorph new.    aboutButton label: 'Sobre Nosotros'.    aboutButton target: self.    aboutButton actionSelector: #showAbout.    aboutButton bounds: ((240 + buttonOffset) @ 430 extent: 140 @ 50).     aboutButton color: buttonColor.     aboutButton borderWidth: 2; borderColor: borderColor.     window addMorph: aboutButton.    "Crea un botón de salida"    exitButton := SimpleButtonMorph new.    exitButton label: 'Salir'.    exitButton target: self.    exitButton actionSelector: #exitGame.    exitButton bounds: ((240 + buttonOffset) @ 500 extent: 140 @ 50).     exitButton color: buttonColor.     exitButton borderWidth: 2; borderColor: borderColor.     window addMorph: exitButton.    " Para abrir la ventana"    window openInWorld.! !!WelcomeInterface class methodsFor: 'as yet unclassified' stamp: 'Anonymous 11/23/2024 21:38'!configureMatrix    dimension := UIManager default request: 'Escribe la dimensión de la matriz (ejemplo: 3 para 3x3):'.    dimension := dimension asInteger ifNil: [ 3 ]. "Valor por defecto si no ingresa nada"    (dimension isInteger and: [dimension > 0]) ifTrue: [        self setMatrixDimension: dimension.        UIManager default inform: 'Configuración actualizada: ', dimension asString, 'x', dimension asString.    ] ifFalse: [        UIManager default inform: 'Por favor, introduce un número válido mayor a 0.'.    ].! !!WelcomeInterface class methodsFor: 'as yet unclassified' stamp: 'uwu 11/24/2024 17:03'!showAbout    | window aboutBackground aboutText |    window := SystemWindow new.    window extent: 500 @ 400.    window setLabel: 'Sobre Nosotros'.    "Agrega la imagen de fondo"    aboutBackground := ImageMorph new.    aboutBackground image: (Form fromFileNamed: (FileLocator imageDirectory / 'sobreNosotros.png') asFileReference).    aboutBackground bounds: (0 @ 0 corner: window extent).    window addMorphBack: aboutBackground.    "Agrega un  texto sobre nosotros"    aboutText := TextMorph new.    aboutText contents: 'Desarrollado por: Los Imaginadores' , String cr , 'Somos un grupo apasionado por los juegos y la creatividad.' , String cr , '¡Esperamos que disfrutes nuestro juego tanto como nosotros disfrutamos creándolo!!'.    aboutText font: (TextStyle default fontOfSize: 14).    aboutText position: (20 @ 50).    aboutText color: Color white.    window addMorph: aboutText.    window openInWorld.! !PackageManifest subclass: #ManifestATRABAJOPARADIGMAS	instanceVariableNames: ''	classVariableNames: ''	package: 'A-TRABAJOPARADIGMAS-Manifest'!!ManifestATRABAJOPARADIGMAS commentStamp: '<historical>' prior: 0!Please describe the package using the class comment of the included manifest class. The manifest class also includes other additional metadata for the package. These meta data are used by other tools such as the SmalllintManifestChecker and the critics Browser!"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!ManifestATRABAJOPARADIGMAS class	instanceVariableNames: ''!!ManifestATRABAJOPARADIGMAS class methodsFor: 'code-critics' stamp: 'uwu 11/24/2024 16:56'!ruleCascadedNextPutAllsRuleV1FalsePositive	^ #(#(#(#RGMethodDefinition #(#Tablero #contarDuelo #false)) #'2024-11-24T16:48:15.297-03:00') #(#(#RGMethodDefinition #(#Tablero #iniciarDuelo #false)) #'2024-11-24T16:48:32.349-03:00') #(#(#RGMethodDefinition #(#Tablero #realizarDueloEntre:y: #false)) #'2024-11-24T16:56:00.056-03:00') )! !!ManifestATRABAJOPARADIGMAS class methodsFor: 'code-critics' stamp: 'uwu 11/24/2024 17:04'!ruleLongMethodsRuleV1FalsePositive	^ #(#(#(#RGMethodDefinition #(#Tablero #iniciarDuelo #false)) #'2024-11-24T16:48:39.068-03:00') #(#(#RGMethodDefinition #(#Tablero #initialize #false)) #'2024-11-24T16:55:37.588-03:00') #(#(#RGMethodDefinition #(#'WelcomeInterface class' #open #true)) #'2024-11-24T16:59:27.059-03:00') #(#(#RGMethodDefinition #(#'WelcomeInterface class' #startGame #true)) #'2024-11-24T17:04:07.007-03:00') )! !!ManifestATRABAJOPARADIGMAS class methodsFor: 'code-critics' stamp: 'uwu 11/24/2024 16:48'!ruleEndTrueFalseRuleV1FalsePositive	^ #(#(#(#RGMethodDefinition #(#Tablero #iniciarDuelo #false)) #'2024-11-24T16:48:30.343-03:00') )! !!ManifestATRABAJOPARADIGMAS class methodsFor: 'code-critics' stamp: 'uwu 11/24/2024 17:03'!ruleUnclassifiedMethodsRuleV1FalsePositive	^ #(#(#(#RGMethodDefinition #